include LICENSE README.md CITATION.cff CITATION.bib CITATION.ris CHANGELOG.md pytest.ini api_manifest.json
include scgeo_io_manifest.json scgeo_io_raw.json
include environment.yml environment-user.yml conda-recipe/meta.yaml
include scripts/smoke_installation.py scripts/check_release.py scripts/verify_testpypi.py
include scripts/rebuild_manifests.py scripts/gen_api_docs.py scripts/validate_manifests.py scripts/check_documentation.py
recursive-include scripts/tests *.py
recursive-include examples *.py
recursive-include docs/assets *.png *.svg
recursive-include scgeo *.py
recursive-include tests *.py
recursive-include configs *.json
recursive-include docs *.md *.json
prune .cache
prune results
prune .git
prune .github
global-exclude __pycache__ *.py[cod]
